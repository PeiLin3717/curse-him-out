# ------------------------------------------------------------
# Copy this file to ".env" and fill in the values from your
# MySQL host (e.g. Aiven → service overview page).
#   cp .env.example .env
# Never commit the real .env (it's already in .gitignore).
# ------------------------------------------------------------

DB_HOST=your-service.aivencloud.com
# ⚠️ Aiven & TiDB use a CUSTOM 5-digit port shown on the service page (e.g. 21893).
# It is NOT 3306. Use 3306 only for a plain local MySQL.
DB_PORT=21893
DB_USER=avnadmin
DB_PASSWORD=your-password-here
DB_NAME=defaultdb

# Cloud MySQL (Aiven, TiDB) needs SSL. Use false ONLY for a plain local MySQL.
DB_SSL=true

# Starting number for the "men cursed out" counter (pure vanity).
COUNT_BASE=12000

# Port to listen on. Leave unset in production — Render sets it for you.
PORT=3000
